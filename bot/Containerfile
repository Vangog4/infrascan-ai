FROM python:3.11-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock* ./

# Install dependencies without the project itself
RUN uv sync --frozen --no-install-project

# Copy source and static assets
COPY src/ ./src/
COPY assets/ ./assets/

# Sync with project installed
RUN uv sync --frozen

ENV PYTHONUNBUFFERED=1

# TODO(non-root): run as an unprivileged user to reduce blast radius. The build
# context is already sanitized via .dockerignore (no .env/secrets/journals). A
# non-root switch is NOT applied here because it cannot be verified in this
# session (image build/start is the orchestrator's responsibility, and touching
# containers is out of scope). When applied, it must be validated to BUILD and
# START cleanly. Prepared snippet to add right before CMD:
#
#   RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
#   USER appuser
#   CMD ["uv", "run", "--no-sync", "python", "-m", "src.bot"]
#
# `--no-sync` makes `uv run` skip startup revalidation (no network, no cache
# write), so the runtime user needs no writable UV_CACHE_DIR/HOME — avoids
# granting write to system caches. The venv is already built by `uv sync
# --frozen` above. Verify /health passes under the new UID before shipping.

CMD ["uv", "run", "python", "-m", "src.bot"]
