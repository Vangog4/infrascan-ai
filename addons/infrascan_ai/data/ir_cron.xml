<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ── Утренний брифинг: 07:45 МСК = 04:45 UTC ── -->
        <record id="cron_morning_digest" model="ir.cron">
            <field name="name">InfraScan: Утренний брифинг инженеров</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">env['project.task'].morning_digest_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-05-18 04:45:00</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- ── Вечерний отчёт: 18:00 МСК = 15:00 UTC ── -->
        <record id="cron_evening_summary" model="ir.cron">
            <field name="name">InfraScan: Вечерний отчёт администратору</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">env['project.task'].evening_summary_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2026-05-18 15:00:00</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- ── Проверка лидов: каждые 2 часа ── -->
        <record id="cron_lead_followup" model="ir.cron">
            <field name="name">InfraScan: Напоминание о необработанных лидах</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">env['project.task'].lead_followup_cron()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="nextcall">2026-05-18 06:00:00</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- ── Ежемесячный B2B-дайджест: 1-е число месяца, 09:00 МСК = 06:00 UTC ── -->
        <record id="cron_monthly_digest" model="ir.cron">
            <field name="name">InfraScan: Ежемесячный дайджест клиентам</field>
            <field name="model_id" ref="infrascan_ai.model_infrascan_bot_report"/>
            <field name="state">code</field>
            <field name="code">env['infrascan.bot.report'].monthly_digest_cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall">2026-06-01 06:00:00</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
