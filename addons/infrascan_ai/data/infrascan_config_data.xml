<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            noupdate="1": значения вставляются только при первой установке.
            Последующие обновления модуля НЕ перезапишут значения, изменённые в UI.
            Чтобы сбросить — удалите запись в UI и запустите обновление модуля.
        -->
        <record id="param_gemini_api_key" model="ir.config_parameter">
            <field name="key">infrascan_ai.gemini_api_key</field>
            <field name="value">REPLACE_WITH_YOUR_GEMINI_API_KEY</field>
        </record>
        <record id="param_gemini_model" model="ir.config_parameter">
            <field name="key">infrascan_ai.gemini_model</field>
            <field name="value">gemini-2.0-flash</field>
        </record>
        <record id="param_telegram_bot_token" model="ir.config_parameter">
            <field name="key">infrascan_ai.telegram_bot_token</field>
            <field name="value">REPLACE_WITH_BOT_TOKEN</field>
        </record>
        <record id="param_telegram_admin_ids" model="ir.config_parameter">
            <field name="key">infrascan_ai.telegram_admin_ids</field>
            <field name="value">REPLACE_WITH_ADMIN_TG_IDS</field>
        </record>
    </data>
</odoo>
