<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── 1. Форма задачи: поле TG-инженера + кнопки ── -->
    <record id="view_task_form_infrascan" model="ir.ui.view">
        <field name="name">project.task.form.infrascan</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Поле TG-инженера после assignees -->
            <field name="user_ids" position="after">
                <field name="x_telegram_id"
                       placeholder="Telegram ID инженера, напр. 123456789"
                       widget="char"/>
                <field name="x_client_tg_id" placeholder="Telegram ID клиента"/>
            </field>

            <!-- Кнопки в шапке формы -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_notify_engineer"
                        type="object"
                        string="📲 Уведомить инженера"
                        class="oe_stat_button"
                        icon="fa-paper-plane"
                        invisible="not x_telegram_id"/>
                <button name="action_analyze_thermal_image"
                        type="object"
                        string="🔬 Анализ Gemini"
                        class="oe_stat_button"
                        icon="fa-search"/>
            </xpath>

        </field>
    </record>

    <!-- ── 2. Список задач InfraScan (выезды) ── -->
    <record id="view_infrascan_task_list" model="ir.ui.view">
        <field name="name">infrascan.task.list</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Выезды"
                  decoration-warning="not x_telegram_id"
                  decoration-success="stage_id.name == '✅ Выполнена'"
                  decoration-muted="stage_id.name == '🗃 Архив'">
                <field name="name" string="Объект"/>
                <field name="stage_id" string="Статус" widget="badge"
                       decoration-success="name == '✅ Выполнена'"
                       decoration-warning="name == '🔧 На объекте'"
                       decoration-info="name in ['👤 Назначена','🚗 В пути']"
                       decoration-muted="name == '🗃 Архив'"/>
                <field name="x_telegram_id" string="Инженер (TG ID)"/>
                <field name="date_deadline" string="Дата выезда"/>
                <field name="project_id" string="Проект" optional="show"/>
                <field name="create_date" string="Создана" optional="hide"/>
                <button name="action_notify_engineer"
                        type="object"
                        string="📲"
                        title="Уведомить инженера"
                        invisible="not x_telegram_id"/>
            </list>
        </field>
    </record>

    <!-- ── 3. Поиск с готовыми фильтрами ── -->
    <record id="view_infrascan_task_search" model="ir.ui.view">
        <field name="name">infrascan.task.search</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Поиск выездов">
                <field name="name" string="Объект"/>

                <filter string="Сегодня"
                        name="today"
                        domain="[('date_deadline','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Без инженера"
                        name="no_engineer"
                        domain="[('x_telegram_id','in',[False,''])]"/>
                <filter string="Просроченные"
                        name="overdue"
                        domain="[('date_deadline','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Только лиды"
                        name="leads"
                        domain="[('name','ilike','[Лид]')]"/>
                <filter string="Не лиды"
                        name="no_leads"
                        domain="[('name','not ilike','[Лид]')]"/>
                <separator/>
                <group>
                    <filter string="Статус"   name="by_stage"    context="{'group_by': 'stage_id'}"/>
                    <filter string="Инженер"  name="by_engineer" context="{'group_by': 'x_telegram_id'}"/>
                    <filter string="Дата"     name="by_date"     context="{'group_by': 'date_deadline:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── 4. Action: выезды ── -->
    <record id="action_infrascan_tasks" model="ir.actions.act_window">
        <field name="name">Выезды</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_ids" eval="[(5,0,0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_infrascan_task_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')}),
        ]"/>
        <field name="search_view_id" ref="view_infrascan_task_search"/>
        <field name="domain">[('name','not ilike','[Лид]')]</field>
        <field name="context">{'search_default_no_leads': 1}</field>
    </record>

    <!-- ── 5. Action: лиды ── -->
    <record id="action_infrascan_leads" model="ir.actions.act_window">
        <field name="name">Лиды</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5,0,0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_infrascan_task_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('project.view_task_form2')}),
        ]"/>
        <field name="search_view_id" ref="view_infrascan_task_search"/>
        <field name="domain">[('name','ilike','[Лид]')]</field>
    </record>

    <!-- ── 6. Меню InfraScan AI ── -->
    <menuitem id="menu_infrascan_root"
              name="InfraScan AI"
              parent="project.menu_main_pm"
              sequence="99"/>

    <menuitem id="menu_infrascan_tasks"
              name="🚗 Выезды"
              parent="menu_infrascan_root"
              action="action_infrascan_tasks"
              sequence="10"/>

    <menuitem id="menu_infrascan_leads"
              name="📋 Лиды"
              parent="menu_infrascan_root"
              action="action_infrascan_leads"
              sequence="20"/>

</odoo>
