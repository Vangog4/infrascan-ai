<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Добавляем поле x_partner_balance в форму контакта -->
    <record id="view_partner_form_infrascan" model="ir.ui.view">
        <field name="name">res.partner.form.infrascan</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="x_partner_balance" widget="monetary"/>
            </field>
        </field>
    </record>
</odoo>
